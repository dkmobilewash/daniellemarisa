# Copy this file to .env.local and fill in real values.

# Resend (https://resend.com) — powers the contact form and lead magnet emails.
RESEND_API_KEY=

# Used by next-sitemap to generate absolute URLs. Should match the live domain.
NEXT_PUBLIC_SITE_URL=https://www.daniellemarisa.com

# Optional: Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Leave blank to disable GTM entirely.
NEXT_PUBLIC_GTM_ID=
